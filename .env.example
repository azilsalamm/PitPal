# Geoapify API key for live garage discovery.
# Precedence: lowercase geoapify_api_key wins over GEOAPIFY_API_KEY if both are set.
geoapify_api_key=
GEOAPIFY_API_KEY=

# Google Gemini API key for photo-assisted vehicle identification.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# Context.dev API key for garage website enrichment and directory listings.
CONTEXT_DEV_API_KEY=

# Server port (default 8787)
PORT=
